# Terraform-managed backup bucket name, without an s3:// prefix.
S3_BUCKET=office-manager-prod-backups
AWS_DEFAULT_REGION=us-east-2

# EC2 uses its instance profile. For a non-EC2 host, configure a named AWS CLI
# profile or short-lived environment credentials outside this file.
# AWS_PROFILE=office-manager-backup

# Keep this aligned with infra/terraform/aws backup_retention_days.
RETENTION_DAYS=35
COMPOSE_PROJECT=office-manager
POSTGRES_USER=office_admin
POSTGRES_DB=office_manager

# AWS production uses RDS. Obtain POSTGRES_PASSWORD at runtime from Secrets
# Manager; do not store it in this file. Leave POSTGRES_HOST blank for the
# legacy local Compose database path.
POSTGRES_HOST=
POSTGRES_PORT=5432
AWS_SECRET_ID=office-manager/prod/app-secrets

# When set, backup.sh records an object manifest instead of archiving a local
# uploads volume. This is the AWS production configuration.
S3_UPLOAD_BUCKET=office-manager-prod-uploads
S3_UPLOAD_PREFIX=uploads
