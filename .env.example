# Database test values
POSTGRES_DB=office_manager
POSTGRES_USER=office_admin
POSTGRES_PASSWORD=change_this_password

# JWT
JWT_SECRET=change_this_to_a_random_secret_key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@officemanager.local
# Optional per-category From addresses. When set, outbound mail uses the
# matching mailbox by purpose; any left blank fall back to SMTP_FROM.
# SYSTEM = account/platform mail (verification, password reset, billing).
# NOTIFICATIONS = reminders, digests, ticket + rule notifications.
# WAIVERS = waiver/COI invitations.
SMTP_FROM_SYSTEM=
SMTP_FROM_NOTIFICATIONS=
SMTP_FROM_WAIVERS=
# Address that receives in-app support requests (Administration > Support
# Requests). Leave blank to disable email forwarding; requests are still
# stored and visible to admins in-app.
SUPPORT_EMAIL=

# AI assist provider. Supported values: gemini, openai, openrouter. Leave
# AI_PROVIDER blank to preserve the legacy behaviour of using Gemini whenever
# GEMINI_API_KEY is configured.
AI_PROVIDER=
AI_MODEL=
AI_MODEL_FAST=
# Generation and embeddings may use different providers. This is recommended
# for OpenRouter generation because embedding availability varies by model.
AI_EMBED_PROVIDER=
AI_EMBED_MODEL=
# Must remain 768 unless the pgvector columns and indexes are migrated.
AI_EMBED_DIMENSIONS=768
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_SECONDS=0.5

# Google Gemini. When another provider is primary, a configured Gemini key and
# model are still used as the scanned/image-only PDF transcription fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FAST=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter. SITE_URL and APP_NAME are sent as attribution headers.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Portfolio Desk
# Largest document the AI endpoints accept (MB). Large files are extracted and
# processed in segments rather than stored, so this is independent of
# MAX_FILE_SIZE_MB (which governs stored attachments, also 75 MB by default).
# Keep any reverse proxy's client_max_body_size above both values.
AI_MAX_FILE_SIZE_MB=75
# Largest file that can be stored as an attachment (MB).
MAX_FILE_SIZE_MB=75

# Stripe subscriptions (optional; values configured in the platform admin
# console override these environment fallbacks). STRIPE_PRICE_ID_PRO is the
# standard graduated monthly Price: $39 flat through quantity 3, then $4 for
# each lease above 3. The legacy Starter/annual fields remain optional for
# existing deployments but are not used by new standard checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_STARTER_ANNUAL=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRODUCT_ID_ENTERPRISE=

# Symmetric encryption key used to store third-party secrets we must send
# back out verbatim: the Buildium client secret, the SSO client secret, and the
# QuickBooks and Plaid OAuth tokens. See app.utils.crypto. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset, secrets are stored in the clear and ONLY when APP_ENV is a development
# value. Any other APP_ENV raises instead of writing plaintext credentials, so
# set this before connecting SSO, QuickBooks or Plaid in a deployed environment.
ENCRYPTION_KEY=

# Buildium migration connector (Administration > System & Data). Credentials
# are entered per-organization in the admin UI, not here; these just tune the
# HTTP client's defaults.
BUILDIUM_API_BASE_URL=https://api.buildium.com/v1
BUILDIUM_TIMEOUT_SECONDS=60

# ── Resident rent payments (optional) ────────────────────────────────
# Charges a resident's tokenised card or bank account from the resident portal.
# Leave PAYMENTS_API_KEY blank to disable: the portal still records the payment
# intent and reports it as uncaptured, so nothing breaks without a processor.
# Only an opaque token is ever accepted; raw card/bank numbers never reach us.
PAYMENTS_PROVIDER=stripe
PAYMENTS_API_KEY=
# Override only for a non-Stripe or sandbox endpoint.
PAYMENTS_API_URL=

# ── Tenant screening (optional) ──────────────────────────────────────
# Credit / criminal / eviction reports for rental applications. Unset, the
# leasing funnel returns a "manual review required" result rather than blocking.
# Enabling this makes you a user of consumer reports: you own FCRA permissible
# purpose, adverse-action notices and dispute handling. See
# app/utils/screening_client.py.
SCREENING_PROVIDER=transunion
SCREENING_API_KEY=
SCREENING_API_URL=
SCREENING_POLL_ATTEMPTS=5
SCREENING_POLL_INTERVAL_SECONDS=2.0

# ── Single sign-on (Enterprise plan) ─────────────────────────────────
# OIDC authorization-code + PKCE. The IdP itself (issuer, client id, secret,
# allowed email domains) is configured per-organization in the app under
# Administration > SSO, not here. This must be reachable by the IdP and
# registered on it as a redirect URI, exactly as written.
SSO_CALLBACK_URL=http://localhost:8000/api/v1/sso/callback

# ── QuickBooks Online sync (optional) ────────────────────────────────
# Pushes posted journal entries and maps the QBO chart of accounts. Create an
# app at developer.intuit.com with the com.intuit.quickbooks.accounting scope.
# QBO_REDIRECT_URI must point at the app's connections PAGE (not the API) and
# match the Intuit app registration byte for byte.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:4001/finance/connections
# Use sandbox until the integration is proven, then switch both of these.
QBO_ENVIRONMENT=production
QBO_API_BASE_URL=https://quickbooks.api.intuit.com/v3/company
# Sandbox: https://sandbox-quickbooks.api.intuit.com/v3/company

# ── Live bank feed via Plaid (optional) ──────────────────────────────
# Imports transactions into bank reconciliation. Enable the Transactions
# product in the Plaid dashboard. Unset, reconciliation still works from
# CSV/OFX upload.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_API_BASE_URL=https://production.plaid.com
# Sandbox: https://sandbox.plaid.com  (test login user_good / pass_good)
PLAID_COUNTRY_CODES=US
# Required for OAuth banks (Chase, Wells Fargo and similar). Without it those
# institutions fail while smaller banks succeed. Register the same URI in the
# Plaid dashboard.
PLAID_REDIRECT_URI=

# Frontend
# Host ports below must match the docker-compose.prod.yml defaults and each
# other; they are bound on 127.0.0.1 for a reverse proxy (Nginx Proxy Manager)
# to reach. Keep all four distinct — reusing a port makes a second container
# fail to bind. Running prod: frontend=4001, backend=4002, landing=4003,
# admin=4004.
FRONTEND_URL=http://localhost:4001
APP_PORT=4001
ADMIN_FRONTEND_URL=http://localhost:4004
ADMIN_PORT=4004
LANDING_PORT=4003
# Host port the backend API is mapped to (used by docker-compose.prod.yml so a
# reverse proxy such as Nginx Proxy Manager can reach the API directly).
BACKEND_PORT=4002

# ── Nginx Proxy Manager (prod ingress) ───────────────────────────────
# docker-compose.prod.yml runs Nginx Proxy Manager as the single public
# ingress (ports 80/443, plus the admin UI on 81). These variables drive the
# idempotent route/SSL provisioner infra/nginx-proxy-manager/bootstrap.py.
# Pin the image; leave blank to use the compose default.
NPM_IMAGE_TAG=2.15.1
# NPM admin API + credentials (defaults match a fresh NPM install; rotate the
# admin account after first boot and update these).
NPM_BASE_URL=http://localhost:81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme
# Email used when requesting Let's Encrypt certificates. Leave blank to skip SSL
# (routes are served over HTTP only until this is set and the script re-run).
NPM_LETSENCRYPT_EMAIL=
# Public domains to expose. Only the ones you set are provisioned; each maps to
# the matching container over the shared `edge` network. NPM_API_DOMAIN is
# optional (the SPA usually calls the API under the same domain via /api).
NPM_FRONTEND_DOMAIN=
NPM_ADMIN_DOMAIN=
NPM_LANDING_DOMAIN=
NPM_API_DOMAIN=

# File storage backend for uploaded attachments: "local" (default; files under
# UPLOAD_DIR) or "s3" (required in the AWS deployment — see
# docs/aws-deployment.md — so uploads survive a container being replaced or
# more than one backend instance running). S3_UPLOAD_BUCKET is required when
# STORAGE_BACKEND=s3; the app authenticates to AWS via the default boto3
# credential chain (e.g. the EC2 instance role), not env-var keys.
STORAGE_BACKEND=local
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=uploads
AWS_REGION=us-east-2

# Default Admin — set a strong password; this account is created on first startup
DEFAULT_ADMIN_EMAIL=admin@officemanager.local
DEFAULT_ADMIN_PASSWORD=change_this_password
# Optional: comma-separated emails promoted to super-admin on every startup
SUPER_ADMIN_EMAILS=

# ── Observability (optional) ─────────────────────────────────────────
# Deployment environment label used to tag logs and Sentry events.
APP_ENV=development
# Root log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Log output: "plain" (human-readable) or "json" (structured, for aggregation).
LOG_FORMAT=plain
# Error tracking via Sentry. Leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
